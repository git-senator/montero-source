# ══════════ КЭШ ══════════
#
# Владелец правит сайт по многу раз в день, и посетитель должен видеть
# свежее немедленно — без перезагрузок, приписок «?1» и чистки браузера.
#
# Страница: no-cache + must-revalidate. Это не запрет хранить, а запрет
# отдавать без проверки: браузер и щит DDoS-Guard каждый раз спрашивают
# сервер «не изменилось ли», и при неизменном файле получают короткий
# ответ 304 вместо всех семидесяти килобайт. Свежесть — мгновенная,
# трафик — почти нулевой.
#
# Статика: год и immutable. Это безопасно, потому что в ссылках на неё
# стоит отпечаток файла (?v=a1b2c3d4): правка файла меняет адрес, и
# браузер скачивает новое сам. Старый адрес просто перестаёт
# запрашиваться.
#
# Файл лежит в корне /public_html и действует на обе версии: телефонную
# в корне и компьютерную в /v3/.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2|ttf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
