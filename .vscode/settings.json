{
  // Папка _publish — это собранный сайт, у неё свой репозиторий, и
  // коммиты туда делают сами deploy.py и deploy_v3.py. В панели
  // «Система управления версиями» она только мозолила глаза вторым
  // разделом с пустым полем сообщения — прячем её оттуда. На выкладку
  // это не влияет: скрипты работают с ней напрямую.
  "git.ignoredRepositories": [
    "_publish",
    "d:\\консьерж сервис\\_publish"
  ],
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    "_publish",
    "_archive",
    "_snapshots"
  ]
}
